{
  "name": "pacific-tsunami-warning-time-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "vite",
    "samples": "vite --config vite.samples.config.ts",
    "samples:build": "tsc --noEmit && vite build --config vite.samples.config.ts",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:demos": "vitest run --config vitest.demos.config.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
