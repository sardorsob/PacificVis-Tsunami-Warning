# Auto detect text files and perform LF normalization
* text=auto

# Matplotlib emits SVG path continuations with meaningful trailing spaces.
*.svg whitespace=-trailing-space

# Preserve the original rejected exploratory run's checksummed CSV bytes.
# Subsequent shared-audit writers emit LF explicitly.
artifacts/eda/shared/2026-10-05-ad040a7/*.csv -text

# Preserve byte-identical scientific receipts and hash-bound source contracts.
artifacts/logs/runs/** -text whitespace=-trailing-space,-blank-at-eof
artifacts/provenance/*.csv -text whitespace=cr-at-eol
config/*.csv -text whitespace=cr-at-eol
config/ia-site-headers-v2.toml -text whitespace=-blank-at-eof
config/arrival-recovery-evidence-v1.toml -text whitespace=-blank-at-eof
config/arrival-recovery-ncei-sample-v1.toml -text whitespace=-blank-at-eof
